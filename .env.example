# Port for the Express server to run on
PORT=3010

# Smart OLT Configuration
# If your URL is https://mycompany.smartolt.com, the subdomain is 'mycompany'
#
# Una sola cuenta/dominio (compatibilidad):
SMARTOLT_SUBDOMAIN=mycompany
SMARTOLT_API_KEY=your_smart_olt_api_token_here
#
# Varias cuentas/dominios (recomendado cuando las OLT no están en el mismo
# dominio Smart OLT). Configure esta única variable en Render como una línea
# JSON. Cada id es interno a esta integración y no debe repetirse.
# No publique las API keys en el repositorio ni en chats.
# SMARTOLT_ACCOUNTS_JSON=[{"id":"dominio-norte","subdomain":"cuenta-norte","apiKey":"token_cuenta_norte"},{"id":"dominio-sur","subdomain":"cuenta-sur","apiKey":"token_cuenta_sur"}]
# Cuando SMARTOLT_ACCOUNTS_JSON existe, reemplaza las dos variables simples de
# arriba. El Radar consulta cada dominio de forma independiente y conserva el
# dominio de origen al correlacionar alertas, NAPs y OLTs.

# Telegram Configuration
# Retrieve Bot Token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345678
# The ID of the Telegram group, channel, or chat where enriched alerts should be sent (for direct webhook workflow)
TELEGRAM_CHAT_ID=-1001234567890
# Optional comma-separated secondary groups/channels that receive the same
# operational alerts. The bot must be a member/admin with permission to post.
# Uno o varios grupos/canales separados por coma.
TELEGRAM_ADDITIONAL_CHAT_IDS=-1009876543210,-1001234567890
# The bot username (including the @) to check for mentions/commands if needed
BOT_USERNAME=@MyZabbixOltBot
# true: cualquier usuario puede usar los comandos públicos y consultar el
# historial. /sync permanece limitado al TELEGRAM_CHAT_ID administrador.
TELEGRAM_BOT_PUBLIC=true

# Telegram connection mode: 'polling' (recommended for development) or 'webhook' (recommended for production)
TELEGRAM_MODE=polling

# Set the public HTTPS base URL of the deployed API (for example, your Render URL).
# PUBLIC_URL=https://alertzabsmartolt.onrender.com

# Tiempo de espera en SEGUNDOS para que Smart OLT registre el evento antes de
# re-consultar y comparar estados con Zabbix.
#
# Flujo:
#   Zabbix detecta anomal\u00eda → actualiza mapa → espera SMARTOLT_SETTLE_SECS →
#   re-consulta Smart OLT con datos frescos → compara → env\u00eda SOLO si ambos concuerdan.
#
# Si llega un evento OK/recuperaci\u00f3n antes de que expire el tiempo, la alerta
# se cancela autom\u00e1ticamente (sin molestar al t\u00e9cnico).
#
# Valores recomendados:
#   15-30s  → OLT r\u00e1pida (latencia baja de Smart OLT)
#   30-60s  → OLT normal (recomendado)
#   0       → Sin espera (modo inmediato, sin ventana de cancelaci\u00f3n)
SMARTOLT_SETTLE_SECS=30

# true: alertas de pérdida/corte solo se envían si Smart OLT las confirma.
# false: si Smart OLT no está disponible, usa Zabbix como respaldo para no perder alertas.
SMARTOLT_REQUIRE_CORROBORATION=true

# Correlación por puerto: evita una alerta por cada ONU cuando el incidente
# afecta varias ONUs del mismo PON. Smart OLT determina el impacto real.
PORT_CORRELATION_ENABLED=true
PORT_CORRELATION_WINDOW_SECS=15
PORT_OUTAGE_MIN_OFFLINE=3
PORT_OUTAGE_MIN_PERCENT=30
# Radius used for the local NAP cause analysis. GPS-less NAPs are not added.
NAP_NEARBY_ANALYSIS_RADIUS_KM=1

# Smart OLT limits full ONU-detail exports. They are used only for the slow
# metadata cache refresh, never by the monitoring radar or alert pipeline.
SMARTOLT_SNAPSHOT_CACHE_SECONDS=3600
SMARTOLT_METADATA_SYNC_MINUTES=60
# Monitoring uses get_onus_statuses and retains the bulk status for at least
# five minutes. A Zabbix burst shares the same snapshot instead of querying
# every ONU individually.
SMARTOLT_STATUS_CACHE_SECONDS=300
# A confirmed Zabbix incident may force one shared status refresh, but never
# more often than this interval.
SMARTOLT_STATUS_FORCE_REFRESH_SECONDS=15
# Individual live ONU reads are reserved for manual technician diagnostics.
# Keep their emergency ceiling low.
SMARTOLT_LIVE_STATUS_MAX_REQUESTS=4
SMARTOLT_LIVE_STATUS_WINDOW_SECONDS=180

# Intervalo en minutos para que el Radar escanee Smart OLT. Si Zabbix no
# genera un evento oportuno, el Radar envía el respaldo Power Fail o LOS.
SMARTOLT_SCAN_INTERVAL_MINUTES=6

# Telegram solo recibe una NAP totalmente afectada: todos sus routers con
# Power fail, todos con LOS, o un corte de fibra explícito de Smart OLT.
# Una NAP con un único router registrado también cuenta como total.
NAP_TOTAL_OUTAGE_MIN_ONUS=1
# ==========================================
# Configuración de Zabbix API (Opcional)
# ==========================================
# Requerido SOLO si deseas usar la ruta de sincronización manual (/webhook/zabbix/sync)
# para reenviar notificaciones perdidas o alertas activas atrapadas en Zabbix.
# ZABBIX_API_URL=http://tu-zabbix.com/api_jsonrpc.php
# ZABBIX_API_TOKEN=tu_token_de_acceso_aqui
# Opcional (si no usas token, puedes usar usuario y contraseña):
# ZABBIX_API_USER=Admin
# ZABBIX_API_PASSWORD=zabbix
