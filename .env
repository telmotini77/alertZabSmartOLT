# Port for the Express server to run on
PORT=3010

# Smart OLT Configuration
SMARTOLT_SUBDOMAIN=servicablegz
SMARTOLT_API_KEY=ae287af051d349a68db0aec4b11cc933 

# Telegram Configuration
TELEGRAM_BOT_TOKEN=8854254866:AAGR9Ujz0a02ZNOTZEd0ZRaGMSPTKNThvjU
TELEGRAM_CHAT_ID=8953554158
# Grupo dedicado para alertas de LOSS OF SIGNAL (fibra cortada, urgente).
# Si no se configura, los LOS van al mismo grupo que Power Fail.
# Para obtener el ID: agrega el bot al nuevo grupo y envía /id
TELEGRAM_LOS_CHAT_ID=
BOT_USERNAME=@apiZSOLTbot

# Telegram connection mode: 'disabled' = solo envío de alertas (recomendado)
# 'polling' = recibir comandos del bot (causa conflictos al reiniciar)
# 'webhook' = requiere URL pública HTTPS
TELEGRAM_MODE=disabled

# URL publica del servidor. Como Zabbix está en la misma LAN, usa la IP local:
PUBLIC_URL=https://alertzabsmartolt.onrender.com

# Tiempo de espera (en segundos) para que Smart OLT registre el evento antes de
# re-consultar y comparar con Zabbix. Ajusta según la latencia real de tu OLT.
# Ejemplo: 30 = esperar 30 segundos. Usa 0 para envío inmediato (sin espera).
SMARTOLT_SETTLE_SECS=2
SMARTOLT_REQUIRE_CORROBORATION=true
NAP_ZABBIX_EVIDENCE_SECS=300
PORT_CORRELATION_ENABLED=false
PORT_CORRELATION_WINDOW_SECS=3
PORT_OUTAGE_MIN_OFFLINE=2
PORT_OUTAGE_MIN_PERCENT=20

# Detección de caída en área: ventana de tiempo para agrupar NAPs caídas (segundos)
AREA_OUTAGE_WINDOW_SECS=60
# Radio máximo en km para considerar dos NAPs como "misma área" geográfica
AREA_OUTAGE_RADIUS_KM=2.0

# Intervalo en minutos para que el Radar escanee a todos los clientes
# en Smart OLT buscando caídas individuales (Ej. 3 = cada 3 minutos)
SMARTOLT_SCAN_INTERVAL_MINUTES=3
ZABBIX_API_URL=http://170.246.85.18:4530/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=2839ae14aca4f53ad71d89d776834db99228b1d33b701c78cae5ebf99321036e
