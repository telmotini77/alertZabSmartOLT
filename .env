# Port for the Express server to run on
PORT=3010

# Smart OLT Configuration
SMARTOLT_SUBDOMAIN=servicablegz
SMARTOLT_API_KEY=ae287af051d349a68db0aec4b11cc933 

# Telegram Configuration
TELEGRAM_BOT_TOKEN=8854254866:AAGR9Ujz0a02ZNOTZEd0ZRaGMSPTKNThvjU
TELEGRAM_CHAT_ID=8953554158
BOT_USERNAME=@apiZSOLTbot

# Telegram connection mode: 'polling' (default) or 'webhook'
TELEGRAM_MODE=webhook

# If using 'webhook' mode, set your public API base URL (e.g. ngrok HTTPS URL)
PUBLIC_URL=https://uneasy-estimate-spinster.ngrok-free.dev

# Tiempo de espera (en segundos) para que Smart OLT registre el evento antes de
# re-consultar y comparar con Zabbix. Ajusta según la latencia real de tu OLT.
# Ejemplo: 30 = esperar 30 segundos. Usa 0 para envío inmediato (sin espera).
SMARTOLT_SETTLE_SECS=2
SMARTOLT_REQUIRE_CORROBORATION=false
PORT_CORRELATION_ENABLED=true
PORT_CORRELATION_WINDOW_SECS=3
PORT_OUTAGE_MIN_OFFLINE=2
PORT_OUTAGE_MIN_PERCENT=20

# Intervalo en minutos para que el Radar escanee a todos los clientes
# en Smart OLT buscando caídas individuales (Ej. 3 = cada 3 minutos)
SMARTOLT_SCAN_INTERVAL_MINUTES=3
ZABBIX_API_URL=http://170.246.85.18:4530/zabbix/api_jsonrpc.php
